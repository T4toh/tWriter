From 012b11907605509f24ceec03266ef7ba4f98df88 Mon Sep 17 00:00:00 2001
From: Tatoh <tatukis@gmail.com>
Date: Fri, 18 Sep 2026 14:54:12 -0300
Subject: [PATCH 1/3] =?UTF-8?q?[es]=20AGREEMENT=5FPOSTPONED=5FADJ:=20?=
 =?UTF-8?q?=C2=ABm=C3=A1s=20seguido=C2=BB=20after=20a=20verb=20is=20adverb?=
 =?UTF-8?q?ial?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

In American Spanish «más/menos seguido» is the adverbial locution meaning 'a
menudo', and it is invariable. The rule reads «seguido» as a postponed
participle and makes it agree with whatever noun precedes it, so «quiero
pasear sin mi armadura más seguido» is reported as needing «seguida», and
«deberíamos hacer estas cosas más seguido» as needing «seguidas».

The new antipattern requires a verb before the locution, which is what the
adverbial reading needs and the adjectival one does not: the noun-phrase cases
(«la serie más seguido», «la película más seguido de la tele») are still
flagged, and a test example is added for the first one to keep it that way.

Note the trigger is not «a feminine noun in front»: «salgo de mi casa más
seguido» was already clean before this patch, while «voy a la playa más
seguido» was not.

Measured on a 810k-word Spanish novel corpus: 24 matches for the rule before,
21 after. The 3 suppressed ones are all this false positive, and no new match
appears.
---
 .../resources/org/languagetool/rules/es/grammar.xml  | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/languagetool-language-modules/es/src/main/resources/org/languagetool/rules/es/grammar.xml b/languagetool-language-modules/es/src/main/resources/org/languagetool/rules/es/grammar.xml
index 912eeb620cf..e9865191cba 100644
--- a/languagetool-language-modules/es/src/main/resources/org/languagetool/rules/es/grammar.xml
+++ b/languagetool-language-modules/es/src/main/resources/org/languagetool/rules/es/grammar.xml
@@ -23594,6 +23594,17 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
                 <token regexp="yes">más|menos</token>
                 <token postag="A.*|V.P.*" postag_regexp="yes"/>
             </antipattern>
+            <antipattern>
+                <!-- «más/menos seguido» with a verb in front is the adverbial
+                     locution 'a menudo', invariable and general in the Americas.
+                     Without a verb («la serie más seguido») it is still a
+                     postponed adjective and stays checked. -->
+                <token postag="V.*" postag_regexp="yes" skip="-1"/>
+                <token regexp="yes">más|menos</token>
+                <token>seguido</token>
+                <example>Quiero pasear sin mi armadura más seguido.</example>
+                <example>Deberíamos hacer estas cosas más seguido.</example>
+            </antipattern>
             <rule>
                 <pattern>
                     <token postag="AQ.*|V.P.*|PX.*" postag_regexp="yes" regexp="yes">.*(motriz|motrices)<exception postag="_GN_.*|ignore_concordance|AQ.CN.|_GV_" postag_regexp="yes"/></token>
@@ -23637,6 +23648,7 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
                 <example correction="pasado">El domingo <marker>pasada</marker> hubo corrida de toros de lujo.</example>
                 <example correction="posibles">De todas las maneras <marker>posible</marker>.</example>
                 <example correction="alta">Construyeron una torre bien <marker>alto</marker>.</example>
+                <example correction="seguida">La serie más <marker>seguido</marker>.</example>
                 <example>Uno de los aspectos migratorios más <marker>criticado</marker></example>
                 <example>con la bobina y la placa electrónica montadas en una caja única</example>
                 <example>El contacto con la cultura y la historia japonesas.</example>
